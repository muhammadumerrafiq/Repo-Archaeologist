# GitHub Personal Access Token (classic, no scopes needed for public data)
# Optional: raises rate limit from 60 to 5,000 requests/hour
GITHUB_TOKEN=

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# In-memory cache TTL in seconds
CACHE_TTL_SECONDS=600

# File budgets
MAX_FILES_TO_FETCH=40
MAX_BYTES_PER_FILE=102400
MAX_TOTAL_BYTES=2097152
